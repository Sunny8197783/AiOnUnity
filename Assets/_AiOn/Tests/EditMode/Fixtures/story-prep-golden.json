    "role": "B물류 공식 메일 · 16:50",
    "lines": [
     "내일부터 서해안 노선 운송이 지연됩니다. (사유는 적혀 있지 않음)"
    ],
    "choices": [
     "fact",
     "guess",
     "rumor"
    ]
   },
   {
    "speaker": "옆자리 동료",
    "role": "대화",
    "lines": [
     "\"취소가 많은 건 다들 전쟁 날 줄 알아서야. 뻔하지.\""
    ],
    "choices": [
     "fact",
     "guess",
     "rumor"
    ]
   },
   {
    "speaker": "동네 단톡방",
    "role": "사진·출처 없음",
    "lines": [
     "\"○○동 대형마트 생수 다 털렸대ㅋㅋ 빨리 사러 가\""
    ],
    "choices": [
     "fact",
     "guess",
     "rumor"
